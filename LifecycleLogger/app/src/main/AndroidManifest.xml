<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.lifecyclelogger">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Lifecycle Logger"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifecycleLogger">

        <!--
            MainActivity is the LAUNCHER activity.
            android.intent.action.MAIN → Entry point of the app
            android.intent.category.LAUNCHER → Shows in app drawer
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            SecondActivity must be declared here.
            If you forget to register an Activity in the Manifest,
            the app CRASHES with ActivityNotFoundException.
            android:exported="false" → cannot be launched by external apps
        -->
        <activity
            android:name=".SecondActivity"
            android:exported="false" />

    </application>

</manifest>